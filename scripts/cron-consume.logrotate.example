# =============================================================================
# Logrotate config for Solace Queue Consumer cron job
# =============================================================================
# This config is auto-generated by: cron-consume.sh install
# It runs as the current user via a cron entry (no root/sudo required).
#
# Location: ~/.solace-consume.logrotate
# State:    ~/.solace-consume.logrotate.state
#
# To test manually:
#   logrotate -d ~/.solace-consume.logrotate
# =============================================================================

/home/myuser/.solace-consume.log {
    # Rotate weekly, keep 4 weeks
    weekly
    rotate 4

    # Don't error if log file is missing
    missingok

    # Don't rotate if empty
    notifempty

    # Compress old logs
    compress
    delaycompress

    # Append date to rotated filename
    dateext
    dateformat -%Y%m%d
}
